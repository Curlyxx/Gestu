data/raw_videos/swipe_derecha/*
!data/raw_videos/swipe_derecha/.gitkeep

data/raw_videos/swipe_izquierda/*
!data/raw_videos/swipe_izquierda/.gitkeep

# Landmarks
data/landmarks/agarrar/*
!data/landmarks/agarrar/.gitkeep

data/landmarks/ninguno/*
!data/landmarks/ninguno/.gitkeep

data/landmarks/swipe_abajo/*
!data/landmarks/swipe_abajo/.gitkeep

data/landmarks/swipe_arriba/*
!data/landmarks/swipe_arriba/.gitkeep

data/landmarks/swipe_derecha/*
!data/landmarks/swipe_derecha/.gitkeep

data/landmarks/swipe_izquierda/*
